{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Platform-agnostic TypeScript library consumed as source",
  "extends": "./strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
